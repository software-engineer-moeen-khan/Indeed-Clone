<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hostinger points the domain at this repository root. Internally route
    # every web request to Laravel's public directory without exposing it
    # in the browser URL.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
